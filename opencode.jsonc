{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "compaction": {
    "auto": false,
    "prune": false,
    "reserved": 10000
  },
  "provider": {
    "nativ": {
      "models": {
        "mlx-community/Qwen3.6-35B-A3B-8bit": {
          "attachment": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 262144,
            "output": 2048
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "Qwen3.6-35B-A3B-8bit",
          "options": {
            "enable_thinking": true
          },
          "reasoning": true,
          "temperature": true,
          "tool_call": true
        }
      },
      "name": "Nativ",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      }
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      "*.log"
    ]
  },
  "lsp": true,
  "permission": {
    "bash": {
      "*": "deny",
      "flake8 *": "allow",
      "mypy *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git branch *": "allow",
      "git fetch *": "allow",
      "git show *": "allow",
      "git remote -v": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "which *": "allow",
      "echo *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "*/opencode-docs-helper.sh *": "allow",
      "*/opencode-docs-helper.sh": "allow",
      "*/fetch-releases.py": "allow",
      "*/fetch-releases.py *": "allow"
    },
    "lsp": "allow",
    "edit": "ask",
    "external_directory": {
      "*": "ask",
      "~/.config/opencode/skills/opencode-release-notes/*": "allow"
    },
    "doom_loop": "ask"
  },
  "plugin": [
    "opencode-session-manager@latest",
    "open-codebase-index",
    "opencode-skill-creator",
    "@cortexkit/opencode-magic-context@0.34.2",
    "@dietrichgebert/ponytail",
    "cc-safety-net",
    "opencode-better-hashline",
    // "opencode-runtime-fallback",
    // "@angdrew/opencode-hashline-plugin",
    // "opencode-froggy"
  ],
  "agent": {
    "plan": {
      "mode": "primary",
      "model": "opencode-go/qwen3.7-plus",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "ls *": "allow",
          "git status *": "allow",
          "git branch *": "allow",
          "git log *": "allow",
          "git diff *": "allow",
          "git show *": "allow",
          "git ls-files *": "allow",
          "git blame *": "allow",
          "git grep *": "allow",
          "git rev-parse *": "allow",
          "git rev-list *": "allow",
          "git describe *": "allow",
          "git merge-base *": "allow",
          "git name-rev *": "allow",
          "git shortlog *": "allow",
          "git for-each-ref *": "allow",
          "git cat-file *": "allow",
          "git tag *": "allow",
          "git remote -v": "allow",
          "git remote get-url *": "allow",
          "git worktree list *": "allow",
          "git stash list *": "allow",
          "git submodule status *": "allow",
          "*/opencode-docs-helper.sh *": "allow",
          "*/opencode-docs-helper.sh": "allow",
          "*/fetch-releases.py": "allow",
          "*/fetch-releases.py *": "allow",
          "*/skills/codeberg-integration/codeberg-helper.py *": "ask"
        },
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "webfetch": "allow",
        "question": "allow",
        "todowrite": "allow",
        "skill": "allow",
        "lsp": "allow",
        "task": {
          "*": "deny",
          "explore": "allow"
        }
      },
      "options": {}
    },
    "build": {
      "mode": "primary",
      "model": "opencode-go/qwen3.7-plus",
      "permission": {
        "edit": "ask",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "webfetch": "allow",
        "skill": "allow",
        "question": "allow",
        "todowrite": "allow",
        "lsp": "allow",
        "bash": {
          "*": "ask",
          "git status *": "allow",
          "git branch *": "allow",
          "git log *": "allow",
          "git diff *": "allow",
          "git show *": "allow",
          "git ls-files *": "allow",
          "git blame *": "allow",
          "git grep *": "allow",
          "git rev-parse *": "allow",
          "git rev-list *": "allow",
          "git describe *": "allow",
          "git merge-base *": "allow",
          "git name-rev *": "allow",
          "git shortlog *": "allow",
          "git for-each-ref *": "allow",
          "git cat-file *": "allow",
          "git tag *": "allow",
          "git remote -v": "allow",
          "git remote get-url *": "allow",
          "git worktree list *": "allow",
          "git stash list *": "allow",
          "git submodule status *": "allow"
        },
        "task": {
          "*": "deny",
          "coder": "allow",
          "explore": "allow",
          "lint": "allow"
        }
      },
      "options": {}
    },
    "explore": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "permission": {
        "read": "allow",
        "lsp": "allow",
        "edit": "deny",
        "grep": "allow",
        "glob": "allow",
        "bash": {
          "*": "ask",
          "git status *": "allow",
          "git diff *": "allow",
          "git log *": "allow",
          "git branch *": "allow",
          "git show *": "allow",
          "git remote -v": "allow",
          "git ls-files *": "allow",
          "git blame *": "allow",
          "git grep *": "allow",
          "git rev-parse *": "allow",
          "git rev-list *": "allow",
          "git describe *": "allow",
          "git merge-base *": "allow",
          "git name-rev *": "allow",
          "git shortlog *": "allow",
          "git for-each-ref *": "allow",
          "git cat-file *": "allow",
          "git tag *": "allow",
          "git remote get-url *": "allow",
          "git worktree list *": "allow",
          "git stash list *": "allow",
          "git submodule status *": "allow"
        }
      },
      "options": {}
    },
    "commit": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "options": {},
      "permission": {
        "skill": {
          "git-commit": "allow"
        },
        "bash": {
          "*": "ask",
          "git status *": "allow",
          "git diff *": "allow",
          "git log *": "allow"
        }
      }
    },
    "coder": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "permission": {
        "edit": "ask",
        "lsp": "allow",
        "read": "allow",
        "bash": {
          "*": "ask",
          "python3 -c *": "deny",
          "python3 *": "deny",
          "bash -c *": "deny"
        }
      },
      "options": {}
    },
    "lint": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "permission": {
        "bash": {
          "*": "ask",
          "flake8 *": "allow",
          "mypy *": "allow",
          "ruff *": "allow",
          "*-lint.sh": "allow",
          "lint.sh": "allow",
          "python3 -c *": "deny",
          "bash -c *": "deny",
          "*/skills/lint-format/scripts/lint-format.sh *": "allow"
        }
      },
      "options": {}
    },
    "task-rabbit": {
      "model": "opencode/deepseek-v4-flash-free",
      "permission": {
        "bash": {
          "python3 *": "deny",
          "bash -c *": "deny",
          "bash *": "deny",
          "*/fetch-releases.py *": "allow"
        }
      }
    }
  }
}

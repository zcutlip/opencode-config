{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "korp_black": "#050505",
    "korp_terminal": "#0A0A0A",
    "korp_dark": "#0E0E17",
    "korp_dark_elevated": "#16162a",
    "korp_red": "#ff003c",
    "korp_red_bright": "#FF3B45",
    "korp_red_dim": "#aa2030",
    "korp_white": "#e5e5e5",
    "korp_grey": "#a0a0a0",

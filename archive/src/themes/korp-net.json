      "light": "#0088aa"
    },
    "syntaxVariable": {
      "dark": "korp_white",
      "light": "#111111"
    },
    "syntaxString": {
      "dark": "korp_amber",
      "light": "#cc7700"
    },
    "syntaxNumber": {
      "dark": "korp_red_bright",
      "light": "korp_red_bright"
    },
    "syntaxType": {
      "dark": "korp_red_bright",
      "light": "korp_red_bright"
    },
    "syntaxOperator": {
      "dark": "korp_red",
      "light": "korp_red"
    },
    "syntaxPunctuation": {
      "dark": "korp_grey",
      "light": "#888888"
    }

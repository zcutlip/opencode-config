{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "purple",
      "green",
      "yellow",
      "cyan",
      "red",
      "orange"
    ],
    "text": {
      "base": "#d1f7ff",
      "muted": "#05d9e8",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.400",
          "$focused": "$hue.neutral.800",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.neutral.800",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "#ff2a6d"
        },
        "warning": {
          "base": "#f9f002"
        },
        "success": {
          "base": "#39ff14"
        },
        "info": {
          "base": "#00ffff"
        }
      }
    },
    "background": {
      "base": "#0d0221",
      "raised": {
        "base": "#1a0533",
        "high": "#2d1b4e",
        "max": "#3d2560"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.800",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.200"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#ff00ff"
    },
    "scrollbar": {
      "base": "$hue.interactive.200"
    },
    "diff": {
      "text": {
        "added": "#39ff14",
        "removed": "#ff2a6d",
        "context": "#2d1b4e",
        "hunkHeader": "#00ffff"
      },
      "background": {
        "added": "#0d3d3d",
        "removed": "#3d0d2d",
        "context": "#1a0533"
      },
      "highlight": {
        "added": "#39ff14",
        "removed": "#ff2a6d"
      },
      "lineNumber": {
        "text": "#05d9e8",
        "background": {
          "added": "#0d3d3d",
          "removed": "#3d0d2d"
        }
      }
    },
    "syntax": {
      "comment": "#ff79c6",
      "keyword": "#ff00ff",
      "function": "#00ffff",
      "variable": "#39ff14",
      "string": "#f9f002",
      "number": "#ff6b35",
      "type": "#ff2a6d",
      "operator": "#00ffff",
      "punctuation": "#d1f7ff"
    },
    "markdown": {
      "text": "#d1f7ff",
      "heading": "#ff2a6d",
      "link": "#00ffff",
      "linkText": "#39ff14",
      "code": "#39ff14",
      "blockQuote": "#f9f002",
      "emphasis": "#00ffff",
      "strong": "#ff2a6d",
      "horizontalRule": "#ff00ff",
      "listItem": "#00ffff",
      "listEnumeration": "#39ff14",
      "image": "#f9f002",
      "imageText": "#ff6b35",
      "codeBlock": "#39ff14"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
  "light": {
    "hue": {
      "gray": {
        "100": "#0d0221",
        "200": "#251543",
        "300": "#443c6c",
        "400": "#6d6f96",

    },
    "markdown": {
      "text": "#0d0221",
      "link": "#05d9e8",
      "blockQuote": "#ff6b35",
      "emphasis": "#05d9e8",
      "listItem": "#05d9e8",
      "imageText": "#f9f002"
    }
  },

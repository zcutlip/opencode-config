{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "red",
      "green",
      "cyan"
    ],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "#a08888",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.400",
          "$focused": "$hue.neutral.800",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.neutral.800",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "#ff003c"
        },
        "warning": {
          "base": "#ff9500"
        },
        "success": {
          "base": "#39ff14"
        },
        "info": {
          "base": "#00d4ff"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.900",
      "raised": {
        "base": "#0A0A0A",
        "high": "#16162a",
        "max": "#1e1e32"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.800",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.200"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#cc1540"
    },
    "scrollbar": {
      "base": "$hue.neutral.600"
    },
    "diff": {
      "text": {
        "added": "#39ff14",
        "removed": "#ff003c",
        "context": "$hue.neutral.400",
        "hunkHeader": "#ff9500"
      },
      "background": {
        "added": "#051a05",
        "removed": "#1a0508",
        "context": "#0A0A0A"
      },
      "highlight": {
        "added": "#39ff14",
        "removed": "#FF3B45"
      },
      "lineNumber": {
        "text": "#aa2030",
        "background": {
          "added": "#051a05",
          "removed": "#1a0508"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "#ff003c",
      "function": "#00d4ff",
      "variable": "$hue.neutral.200",
      "string": "#ff9500",
      "number": "#FF3B45",
      "type": "#FF3B45",
      "operator": "#ff003c",
      "punctuation": "$hue.neutral.400"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "#ff003c",
      "link": "#ff003c",
      "linkText": "#FF3B45",
      "code": "#ff003c",
      "blockQuote": "$hue.neutral.400",
      "emphasis": "#ff003c",
      "strong": "#ff003c",
      "horizontalRule": "#aa2030",
      "listItem": "#FF3B45",
      "listEnumeration": "#ff9500",
      "image": "#ff9500",
      "imageText": "$hue.neutral.400",
      "codeBlock": "#ff003c"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
  "light": {
    "hue": {
      "gray": {
        "100": "#050505",
        "200": "#282828",
        "300": "#4c4c4c",
        "400": "#747474",
        "500": "#a0a0a0",

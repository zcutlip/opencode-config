      },
      "lineNumber": {
        "text": "#666666",
        "background": {
          "added": "#d0ffd0",
          "removed": "#ffd0d5"
        }
      }
    },
    "syntax": {
      "comment": "#888888",
      "function": "#0088aa",
      "variable": "#111111",
      "string": "#cc7700",
      "punctuation": "#888888"
    },
    "markdown": {
      "text": "#111111",
      "linkText": "#FF3B45",
      "blockQuote": "#666666",
      "horizontalRule": "#cc8899",
      "listItem": "#FF3B45",
      "listEnumeration": "#cc7700",
      "image": "#cc7700",
      "imageText": "#666666"
    }
  },

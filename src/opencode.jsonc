{
  // V2 config — rebuilt gradually, strangler-fig style, from the V1 setup.
  // The V1 config is archived at ../archive/src/ — see ../LEDGER.md
  // (the port ledger) before pulling anything out of the archive.
  "$schema": "https://opencode.ai/config.json",

  // Default model — switched 2026-10 from V1's commandcode/z-ai/glm-5.3-flash
  // (the ported starting reference).
  "model": "opencode-go/glm-5.3-flash",

  // Former V1 `small_model`: the hidden title agent's model.
  "agents": {
    "title": {
      "model": "opencode-go/longcat-2.5-preview-free"
    }
  },

  // Live posture: shell asks by default; "always allow" approvals accumulate
  // durable project-scoped rules on top (audit them with `oc-permissions`).
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "deny" }
  ],

  // Magic Context (anti-compaction + persistent memory) — see LEDGER.md.
  "plugins": ["@cortexkit/opencode-magic-context@latest"],

  // Its required setup: the host's compaction would interfere, so it is off.
  "compaction": {
    "auto": false
  },

  // Local MLX server — the V1 `nativ` provider in the V2 shape.
  // Field mapping: npm -> package, options.baseURL -> settings.baseURL,
  // tool_call/modalities/attachment -> capabilities, interleaved.field ->
  // compatibility.reasoningField, options -> settings, limit unchanged.
  // Dropped as V2-ignored: reasoning, temperature.
  "providers": {
    "nativ": {
      "name": "Nativ",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "Qwen3.6-35B-A3B-8bit": {
          "modelID": "mlx-community/Qwen3.6-35B-A3B-8bit",
          "name": "Qwen3.6-35B-A3B-8bit",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": {
            "context": 262144,
            "output": 2048
          },
          "settings": {
            "enable_thinking": true
          }
        }
      }
    }
  }
}

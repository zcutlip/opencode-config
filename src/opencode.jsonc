{
  // V2 config — rebuilt gradually, strangler-fig style, from the V1 setup.
  // The V1 config is archived at ../archive/src/ — see ../LEDGER.md
  // (the port ledger) before pulling anything out of the archive.
  "$schema": "https://opencode.ai/config.json",

  // Default model — 2026-10-16: everything unified on opencode/glm-5.3-flash-free
  // (the opencode/ PAYG free tier). Before that opencode-go/glm-5.3-flash,
  // ported from V1's commandcode/z-ai/glm-5.3-flash.
  "model": "opencode/glm-5.3-flash-free",

  // Former V1 `small_model`: the hidden title agent's model.
  // 2026-10-16: unified on opencode/glm-5.3-flash-free with the rest of the
  // config; was opencode/big-pickle (chosen 2026-10-11 over the opencode-go
  // free tier, which shuts off at the Go limit, and over -preview models,
  // which evaporate).
  "agents": {
    "title": {
      "model": "opencode/glm-5.3-flash-free"
    },
    // The exclusive commit route. OpenCode wiring only: mode, cheap permuting
    // model, step bound, and the permission fence live here — the agent's
    // Markdown (src/agents/commit.md) is harness-agnostic and carries none of
    // this. Rule order inside the list matters: deny-everything first, then
    // the allowlist, so the last matching rule is the specific allowance.
    // The ONLY ask in the fence is `git commit` itself; everything not
    // explicitly allowed is denied outright (2026-10-17: shell catch-all
    // tightened ask → deny — under it, any command could ride a prompt).
    "commit": {
      "description": "Git commit specialist. Creates atomic, well-formatted commits when explicitly requested by user.",
      "mode": "subagent",
      "steps": 18,
      "model": "opencode/glm-5.3-flash-free",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "shell", "resource": "git add *", "effect": "allow" },
        // Index-only by git's definition (restores the index entry to HEAD;
        // never touches worktree or history). Required to split a mixed index
        // atomically — its denial is what forced 3be6e0c into one commit.
        { "action": "shell", "resource": "git restore --staged *", "effect": "allow" },
        { "action": "shell", "resource": "git commit *", "effect": "ask" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "git-commit", "effect": "allow" }
      ]
    },
    // Build agent (shipped id): additional read-only set beyond the global
    // base — toolchain/artifact diagnostics and static analysis, the
    // generic building tools valid in any project (project-specific
    // scripts live in this repo's root opencode.jsonc, not here).
    // Version probes are exact literals: no trailing wildcard, so no
    // argument form rides them.
    "build": {
      "permissions": [
        { "action": "shell", "resource": "which *", "effect": "allow" },
        { "action": "shell", "resource": "file *", "effect": "allow" },
        { "action": "shell", "resource": "stat *", "effect": "allow" },
        { "action": "shell", "resource": "readlink *", "effect": "allow" },
        { "action": "shell", "resource": "flake8 *", "effect": "allow" },
        { "action": "shell", "resource": "mypy *", "effect": "allow" },
        { "action": "shell", "resource": "bun --version", "effect": "allow" },
        { "action": "shell", "resource": "node --version", "effect": "allow" },
        { "action": "shell", "resource": "python3 --version", "effect": "allow" }
      ]
    }
  },

  // Live posture: shell asks by default; "always allow" approvals accumulate
  // durable project-scoped rules on top (audit them with `oc-permissions`).
  // Git is read-preferring at the global level: the catch-all `git *` ask
  // sits before the read-only allows (last match wins), so every git
  // subcommand not explicitly allowlisted — mutating ones and future ones —
  // requires asking rather than a silent ride-along. Ask, not deny, is
  // deliberate: one-off approvals can promote a command as they surface.
  // Staging and committing happen only via the commit subagent, whose
  // agent rules append after these and override the catch-all for itself
  // (options/agents/commit wiring below); it must ask before `git commit`.
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git *", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git cat-file *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-list *", "effect": "allow" },
    { "action": "shell", "resource": "git describe *", "effect": "allow" },
    { "action": "shell", "resource": "git grep *", "effect": "allow" },
    // Exact-literal reads of mutator subcommands: no trailing " *", so only
    // the literal list forms are allowlisted; every other form of these
    // subcommands falls through to the catch-all above.
    { "action": "shell", "resource": "git tag -l", "effect": "allow" },
    { "action": "shell", "resource": "git remote -v", "effect": "allow" },

    // Base = rudimentary: the splices agents actually reach shell for.
    // Anything beyond these falls to the ask gate (dedicated Grep/Glob
    // tools cover search and file-matching; rarer diagnostics aren't
    // worth standing pre-approval).
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "pwd *", "effect": "allow" },
    // Any command with a redirect (>, >>, 2>) asks — redirect writes never
    // pass silently even when the command itself is allowlisted. Ask, not
    // deny: the user decides what lands where. Last shell rule, so it wins.
    { "action": "shell", "resource": "*> *", "effect": "ask" },
    // opencode config, agent definitions, and the service secret are
    // read-only for agents outside this repository. Patterns anchor on
    // FILENAMES, not paths — they hold on any machine, and canonicalized
    // edits (the ~/.config/opencode symlink resolves into this repo) still
    // end in the filename. Bare patterns catch project-root files; "**/"
    // catches every nested form (.opencode/, .config/, src/...).
    // "opencode.json*" covers both extensions — the loader reads .json too.
    // Agent .md files are locked because their frontmatter permissions
    // OVERRIDE config fences (verified 2026-10-11: a probe agent's
    // frontmatter allow beat a live config deny, and its frontmatter deny
    // removed the tool entirely). When frontmatter is silent, config rules
    // govern — verified with a neutral probe (fm silent + config edit-deny:
    // write tool withheld, no file created). The repo-root opencode.jsonc carves a
    // read/write exception for this repo (the fig requires config editing
    // here); project rules append after these globals, so its allows win.
    // The user's own TUI/manual writes are unaffected — they never pass
    // through agent tool permissions.
    { "action": "edit", "resource": "opencode.json*", "effect": "deny" },
    { "action": "edit", "resource": "**/opencode.json*", "effect": "deny" },
    { "action": "edit", "resource": "cli.json", "effect": "deny" },
    { "action": "edit", "resource": "**/cli.json", "effect": "deny" },
    { "action": "edit", "resource": "agents/*.md", "effect": "deny" },
    { "action": "edit", "resource": "**/agents/*.md", "effect": "deny" },
    // V2 still discovers the V1-compat agent dirs (agent/, mode/, modes/) —
    // each is a frontmatter-permissions surface, so each is fenced too.
    // Collateral: ordinary projects with same-named doc dirs are denied;
    // add narrow allows on friction. (Gap found + demonstrated live
    // 2026-10-11: .opencode/agent/ was writable while .opencode/agents/
    // was denied.)
    { "action": "edit", "resource": "agent/*.md", "effect": "deny" },
    { "action": "edit", "resource": "**/agent/*.md", "effect": "deny" },
    { "action": "edit", "resource": "mode/*.md", "effect": "deny" },
    { "action": "edit", "resource": "**/mode/*.md", "effect": "deny" },
    { "action": "edit", "resource": "modes/*.md", "effect": "deny" },
    { "action": "edit", "resource": "**/modes/*.md", "effect": "deny" },
    { "action": "edit", "resource": "service.json", "effect": "deny" },
    { "action": "edit", "resource": "**/service.json", "effect": "deny" }
  ],

  // Magic Context (anti-compaction + persistent memory) — see LEDGER.md.
  "plugins": [
    "@cortexkit/opencode-magic-context@latest",
    "opencode-cmd-provider"
  ],

  // Its required setup: the host's compaction would interfere, so it is off.
  "compaction": {
    "auto": false
  },

  // Local MLX server — the V1 `nativ` provider in the V2 shape.
  // Field mapping: npm -> package, options.baseURL -> settings.baseURL,
  // tool_call/modalities/attachment -> capabilities, interleaved.field ->
  // compatibility.reasoningField, options -> settings, limit unchanged.
  // Dropped as V2-ignored: reasoning, temperature.
  "providers": {
    "nativ": {
      "name": "Nativ",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "Qwen3.6-35B-A3B-8bit": {
          "modelID": "mlx-community/Qwen3.6-35B-A3B-8bit",
          "name": "Qwen3.6-35B-A3B-8bit",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": {
            "context": 262144,
            "output": 2048
          },
          "settings": {
            "enable_thinking": true
          }
        }
      }
    }
  }
}

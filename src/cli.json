{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "matrix",
    "mode": "dark"
  },
  "diffs": {
    "wrap": "word"
  },
  "prompt": {
    "paste": "full"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "permissions": "prompt"
  },
  "animations": true,
  "attention": {
    "notifications": true,
    "sound": true
  },
  "tabs": {
    "mode": "auto",
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "status"
  }
}

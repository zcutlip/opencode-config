{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": true,
    // "small_model": "opencode/gpt-5-nano",
    "compaction": {
        "auto": true,
        "prune": true,
        "reserved": 10000
    },
    "watcher": {
        "ignore": ["node_modules/**", "dist/**", "build/**", ".git/**", "*.log"]
    },
    "permission": {
        "bash": {
            "*": "ask",
            "flake8 *": "allow",
            "mypy *": "allow",
            "git status *": "allow",
            "git diff *": "allow",
            "git log *": "allow",
            "git branch *": "allow",
            "git fetch *": "allow",
            "git show *": "allow",
            "git remote -v": "allow",
            "ls *": "allow",
            "cat *": "allow",
            "head *": "allow",
            "tail *": "allow",
            "grep *": "allow",
            "find *": "allow",
            "which *": "allow",
            "echo *": "allow",
            "pwd": "allow",
            "whoami": "allow",
            "rm -rf *": "deny",
            "sudo *": "deny"
        },
        "lsp": "allow",
        "git status": "allow",
        "edit": "ask",
        "write": "ask",
        "external_directory": "ask",
        "doom_loop": "ask"
    },
    "plugin": [
        "@tarquinen/opencode-dcp@latest",
        "opencode-session-manager",
        "opencode-auto-resume"],
    // "mcp": {
    //     "my-local-mcp-server": {
    //         "type": "local",
    //         "command": [
    //             "forgejo-mcp"
    //         ],
    //         "enabled": true
    //     }
    // },
    "agent": {
        "plan": {
            "mode": "primary",
            "model": "opencode-go/glm-5",
            "permission": {
                "edit": "deny",
                "write": "deny",
                "question": "allow",
                "read": {
                    "*": "deny",
                    "**/docs/**": "allow",
                    "**/*.md": "allow"
                },
            },
        },
        "build": {
            "mode": "primary",
            "model": "opencode-go/kimi-k2.5",
            "permission": {
                "task": "allow",
                "edit": "ask",
            }
        },
        "explore": {
            "mode": "subagent",
            "model": "opencode-go/mimo-v2-omni"
        },
        "commit": {
            "mode": "subagent",
            "model": "opencode-go/mimo-v2-omni"
        },
        "coder": {
            "mode": "subagent",
            "model": "opencode-go/mimo-v2-pro",
            "permission": {
                "lsp": "allow"
            }
        },
        "lint": {
            "mode": "subagent",
            "model": "opencode/big-pickle"
        },
    }
}

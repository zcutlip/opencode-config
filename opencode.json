{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      "*.log"
    ]
  },
  "lsp": true,
  "permission": {
    "bash": {
      "*": "ask",
      "flake8 *": "allow",
      "mypy *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git branch *": "allow",
      "git fetch *": "allow",
      "git show *": "allow",
      "git remote -v": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "which *": "allow",
      "echo *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "**/opencode-docs-helper.sh *": "allow",
      "**/opencode-docs-helper.sh": "allow"
    },
    "lsp": "allow",
    "edit": "ask",
    "external_directory": "ask",
    "doom_loop": "ask"
  },
  "plugin": [
    "opencode-runtime-fallback",
    "@tarquinen/opencode-dcp@latest",
    "opencode-session-manager@latest",
    "@angdrew/opencode-hashline-plugin"
    // "psinetron-opencode-visualizer",
    // "opencode-froggy"
  ],
  "agent": {
    "plan": {
      "mode": "primary",
      // "model": "chutes/zai-org/GLM-5-TEE",
      "model": "opencode-go/deepseek-v4-pro",
      // "model": "opencode-go/minimax-m3",
      "permission": {
        "edit": "deny",
        "question": "allow",
        "read": {
          "*": "deny",
          "**/docs/**": "allow",
          "**/*.md": "allow"
        }
      },
      "options": {}
    },
    "build": {
      "mode": "primary",
      "model": "chutes/zai-org/GLM-5-TEE",
      "permission": {
        "task": "allow",
        "edit": "ask"
      },
      "options": {}
    },
    "explore": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      // "model": "opencode/deepseek-v4-flash",
      "permission": {
        "read": "allow",
        "lsp": "allow",
        "edit": "deny",
        "bash": {
          "ls *": "allow",
          "cat *": "allow",
          "grep *": "allow",
          "find *": "allow"
        }
      },
      "options": {}
    },
    "commit": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      // "model": "opencode/deepseek-v4-flash",
      "options": {},
      "permission": {
        "skill": {
          "git-commit": "allow"
        },
        "bash": {
          "git status *": "allow",
          "git diff *": "allow",
          "git log *": "allow"
        }
      }
    },
    "coder": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      // "model": "opencode/deepseek-v4-flash",
      "permission": {
        "edit": "ask",
        "lsp": "allow",
        "read": "allow",
        "bash": {
          "python3 -c *": "deny",
          "bash -c *": "deny"
        }
      },
      "options": {}
    },
    "lint": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      // "model": "opencode/deepseek-v4-flash",
      "permission": {
        "bash": {
          "flake8 *": "allow",
          "mypy *": "allow",
          "ruff *": "allow",
          "*-lint.sh": "allow",
          "python3 -c *": "deny",
          "bash -c *": "deny"
        }
      },
      "options": {}
    }
  }
}

{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": true,
    // "small_model": "openrouter/google/gemma-3-4b-it",
    "compaction": {
        "auto": true,
        "prune": true,
        "reserved": 10000
    },
    "watcher": {
        "ignore": ["node_modules/**", "dist/**", "build/**", ".git/**", "*.log"]
    },
    "permission": {
        "bash": {
            "*": "ask",
            "flake8*": "allow",
            "mypy*": "allow",
            "git status*": "allow",
            "git diff*": "allow",
            "git log*": "allow",
            "git branch*": "allow",
            "git fetch*": "allow",
            "git show*": "allow",
            "git remote -v": "allow",
            "ls*": "allow",
            "cat *": "allow",
            "head *": "allow",
            "tail *": "allow",
            "grep *": "allow",
            "find *": "allow",
            "which *": "allow",
            "echo *": "allow",
            "pwd": "allow",
            "whoami": "allow",
            "rm -rf*": "deny",
            "sudo *": "deny"
        },
        "git status": "allow",
        "edit": "ask",
        "write": "ask",
        "external_directory": "ask",
        "doom_loop": "ask"
    },
    "plugin": ["@tarquinen/opencode-dcp@latest"],
    "mcp": {
        "my-local-mcp-server": {
            "type": "local",
            "command": [
                "forgejo-mcp"
            ],
            "enabled": true
        }
    },
    "agent": {
        "plan": {
            "mode": "primary",
            "model": "opencode/qwen3.6-plus-free",
            "permission": {
                "edit": "deny",
                "write": "deny"
            }
        },
        "build": {
            "mode": "primary",
            "model": "opencode/qwen3.6-plus-free",
            "permission": {
                "task": "allow",
                "edit": "deny"
            }
        },
        "explore": {
            "mode": "subagent",
            "model": "opencode/qwen3.6-plus-free",
        }
    }
}
